<mei xmlns="http://www.music-encoding.org/ns/mei" meiversion="5.0">
   <meiHead><fileDesc><titleStmt><title>Chord head columns at explicit staff locations</title></titleStmt><pubStmt/></fileDesc></meiHead>
   <music><body><mdiv><score>
      <scoreDef meter.count="4" meter.unit="4"><staffGrp>
         <staffDef n="1" lines="5" clef.shape="G" clef.line="2"/>
      </staffGrp></scoreDef>
      <section><measure n="1"><staff n="1"><layer n="1">
         <chord dur="4" stem.dir="up">
            <note xml:id="up-c" pname="c" oct="4" loc="0"/>
            <note xml:id="up-e" pname="e" oct="4" loc="2"/>
            <note xml:id="up-g" pname="g" oct="4" loc="3"/>
         </chord>
         <chord dur="4" stem.dir="down">
            <note xml:id="down-c" pname="c" oct="4" loc="0"/>
            <note xml:id="down-e" pname="e" oct="4" loc="2"/>
            <note xml:id="down-g" pname="g" oct="4" loc="3"/>
         </chord>
         <chord dur="4">
            <note xml:id="pair-c" pname="c" oct="4" loc="0"/>
            <note xml:id="pair-cs" pname="c" oct="4" accid="s" loc="0"/>
         </chord>
         <chord dur="4">
            <note xml:id="wide-c" pname="c" oct="4" loc="0"/>
            <note xml:id="wide-d" pname="d" oct="4" loc="4"/>
         </chord>
      </layer></staff></measure></section>
   </score></mdiv></body></music>
</mei>
